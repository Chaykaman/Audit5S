<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Audit5S" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="colorPrimary">#004f9e</item>
        <item name="colorPrimaryDark">#003d7a</item>
        <item name="colorAccent">#5cc4f2</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#003d7a</item>
        <item name="android:navigationBarColor">#1e1e1e</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>